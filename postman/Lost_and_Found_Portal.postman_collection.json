                  "pm.test('Status is REMOVED', () => {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.data.status).to.eql('REMOVED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/reports/{{reportId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adminNotes\": \"Inappropriate content - removed by admin\"\n}"
            }
          }
        },
